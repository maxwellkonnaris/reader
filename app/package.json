{
  "name": "blitz",
  "version": "0.1.0",
  "private": true,
  "description": "Read textbooks aloud on the real page -- PDF, EPUB or a documentation site -- with the spoken words highlighted in place.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "setup:speech": "./scripts/setup-speech.sh",
    "setup:formula": "./scripts/setup-formula.sh",
    "mathspeech:check": "node scripts/mathspeech-check.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:dist": "BLITZ_SMOKE_BIN=release/linux-unpacked/blitz node scripts/smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "onnxruntime-node": "^1.29.0",
    "pdfjs-dist": "6.3.289",
    "ppu-doclayout": "^1.0.0",
    "sharp": "^0.35.4",
    "speech-rule-engine": "^5.0.0-rc.4",
    "tokenizers": "^0.23.2"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.5",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "dev.blitz.reader",
    "productName": "Blitz",
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "HyperToken9 <HyperToken9@users.noreply.github.com>"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/tts_server.py"
    ]
  },
  "allowScripts": {
    "onnxruntime-node@1.29.0": true,
    "esbuild@0.28.2": true,
    "electron@44.2.0": true
  },
  "homepage": "https://github.com/HyperToken9/reader",
  "author": "HyperToken9",
  "repository": {
    "type": "git",
    "url": "https://github.com/HyperToken9/reader.git"
  }
}
